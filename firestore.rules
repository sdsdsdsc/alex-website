rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Production-merge review draft only.
    // This repo did not previously contain local Firestore rules, so this file must
    // be reviewed before any Firebase Console update or deploy step. It does not
    // represent a deployed change on its own.

    function isAdmin() {
      return request.auth != null
        && request.auth.uid == "VT3I9KMktMXsdJeyYBye54Sgnqu2";
    }

    function isNominationOwner() {
      return request.auth != null
        && resource.data.submittedByUid == request.auth.uid;
    }

    function hasField(fieldName) {
      return request.resource.data.keys().hasAny([fieldName]);
    }

    function isAllowedCriteria(criteria) {
      return criteria is list
        && criteria.size() > 0
        && criteria.size() <= 9
        && criteria.hasOnly([
          'Historic interest',
          'Social or communal value',
          'Landmark or streetscape value',
          'Architectural, design or artistic interest',
          'Archaeological or evidential interest',
          'Rarity',
          'Group value',
          'Age',
          'Condition or vulnerability'
        ]);
    }

    function isTrimmedString(value, maxLength) {
      return value is string
        && value.size() > 0
        && value.size() <= maxLength;
    }

    function isValidEmailString(value, maxLength) {
      return isTrimmedString(value, maxLength)
        && value.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$');
    }

    function isOptionalString(fieldName, maxLength) {
      return request.resource.data.get(fieldName, null) == null
        || (
          request.resource.data.get(fieldName, null) is string
          && request.resource.data.get(fieldName, '').size() <= maxLength
        );
    }

    function isOptionalHttpsEvidenceUrl(fieldName, maxLength) {
      return request.resource.data.get(fieldName, null) == null
        || (
          request.resource.data.get(fieldName, null) is string
          && request.resource.data.get(fieldName, '').size() > 0
          && request.resource.data.get(fieldName, '').size() <= maxLength
          && request.resource.data.get(fieldName, '').matches('^https://[^\\s/]+\\.[^\\s/]+[^\\s]*$')
        );
    }

    function isOptionalNumber(fieldName) {
      return request.resource.data.get(fieldName, null) == null
        || request.resource.data.get(fieldName, null) is int
        || request.resource.data.get(fieldName, null) is float
        || (
          request.resource.data.get(fieldName, null) is string
          && request.resource.data.get(fieldName, '').size() > 0
          && request.resource.data.get(fieldName, '').size() <= 40
          && request.resource.data.get(fieldName, '').matches('^-?[0-9]+(\\.[0-9]+)?$')
        );
    }

    function hasUploadedEvidencePath() {
      return hasField('evidenceStoragePath')
        && request.resource.data.evidenceStoragePath is string
        && request.resource.data.evidenceStoragePath.size() > 0;
    }

    function isValidUploadedEvidenceUid() {
      return request.resource.data.get('evidenceUploadedByUid', null) == null
        || request.resource.data.get('evidenceUploadedByUid', '') == ''
        || request.resource.data.get('evidenceUploadedByUid', '') == request.auth.uid;
    }

    function isValidUploadedEvidenceMetadata() {
      return isOptionalString('evidenceFileName', 255)
        && isValidUploadedEvidenceUid()
        && (
          !hasUploadedEvidencePath()
          || (
            request.resource.data.evidenceStoragePath is string
          && request.resource.data.evidenceStoragePath.size() <= 1000
          && request.resource.data.evidenceStoragePath.matches('^nomination-evidence/' + request.auth.uid + '/[^/]+/[^/]+$')
          && request.resource.data.evidenceFileContentType in [
            'image/jpeg',
            'image/png',
            'image/webp',
            'image/gif'
          ]
          && request.resource.data.evidenceFileSize is int
          && request.resource.data.evidenceFileSize > 0
          && request.resource.data.evidenceFileSize <= 5 * 1024 * 1024
          && request.resource.data.evidenceUploadedByUid == request.auth.uid
          && request.resource.data.evidenceVisibility == 'nomination-private'
          && request.resource.data.evidencePermissionConfirmed == true
          )
        );
    }

    function hasValidNominationFields() {
      return request.resource.data.keys().hasOnly([
          'title',
          'assetType',
          'area',
          'address',
          'lat',
          'lng',
          'description',
          'localSignificanceSummary',
          'heritageCriteria',
          'criteriaExplanation',
          'condition',
          'communityUse',
          'sourceReference',
          'evidenceImageUrl',
          'evidenceImageCaption',
          'evidenceCaption',
          'evidenceSourceCredit',
          'evidenceRightsStatus',
          'evidencePermissionConfirmed',
          'evidenceVisibility',
          'evidenceStoragePath',
          'evidenceFileName',
          'evidenceFileContentType',
          'evidenceFileSize',
          'evidenceUploadedAt',
          'evidenceUploadedByUid',
          'photoUrl',
          'photoDescription',
          'nominatorDisplayName',
          'nominatorEmail',
          'organisationName',
          'submittedOnBehalfOf',
          'submittedByUid',
          'submitterEmail',
          'submitterDisplayName',
          'submissionAuthType',
          'termsAccepted',
          'privacyAccepted',
          'nominationStatus',
          'createdAt',
          'updatedAt',
          'submittedAt'
        ])
        && request.resource.data.keys().hasAll([
          'title',
          'address',
          'description',
          'localSignificanceSummary',
          'heritageCriteria',
          'criteriaExplanation',
          'nominatorEmail',
          'submittedByUid',
          'submitterEmail',
          'submissionAuthType',
          'termsAccepted',
          'privacyAccepted',
          'nominationStatus',
          'createdAt',
          'updatedAt',
          'submittedAt'
        ]);
    }

    function isValidNominationCreate() {
      return hasValidNominationFields()
        && request.auth != null
        && isTrimmedString(request.resource.data.title, 160)
        && isTrimmedString(request.resource.data.address, 1000)
        && isTrimmedString(request.resource.data.description, 5000)
        && isTrimmedString(request.resource.data.localSignificanceSummary, 2000)
        && isAllowedCriteria(request.resource.data.heritageCriteria)
        && isTrimmedString(request.resource.data.criteriaExplanation, 5000)
        && isValidEmailString(request.resource.data.nominatorEmail, 254)
        && request.resource.data.submittedByUid == request.auth.uid
        && isValidEmailString(request.resource.data.submitterEmail, 254)
        && request.resource.data.submissionAuthType == 'signedIn'
        && request.resource.data.termsAccepted == true
        && request.resource.data.privacyAccepted == true
        && request.resource.data.nominationStatus == 'submitted'
        && (
          request.resource.data.get('evidencePermissionConfirmed', null) == null
          || request.resource.data.get('evidencePermissionConfirmed', null) is bool
        )
        && (
          request.resource.data.get('evidenceVisibility', null) == null
          || request.resource.data.get('evidenceVisibility', '') == ''
          || request.resource.data.get('evidenceVisibility', '') == 'nomination-private'
        )
        && isValidUploadedEvidenceMetadata();
    }

    function isValidNominationReviewStatus(value) {
      return value in [
        'submitted',
        'under review',
        'needs more information',
        'approved',
        'rejected'
      ];
    }

    function isValidReviewHistory() {
      return !hasField('reviewHistory')
        || (
          request.resource.data.reviewHistory is list
          && request.resource.data.reviewHistory.size() <= 50
        );
    }

    function isValidNominationReviewUpdate() {
      return resource.data.nominationStatus != 'promoted'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'nominationStatus',
          'adminNotes',
          'adminHistoricInterest',
          'adminArchitecturalInterest',
          'adminCommunityValue',
          'adminConditionRisk',
          'adminAssessmentSummary',
          'reviewHistory',
          'reviewedAt',
          'updatedAt'
        ])
        && isValidNominationReviewStatus(request.resource.data.nominationStatus)
        && request.resource.data.adminNotes is string
        && request.resource.data.adminNotes.size() <= 5000
        && request.resource.data.adminHistoricInterest is bool
        && request.resource.data.adminArchitecturalInterest is bool
        && request.resource.data.adminCommunityValue is bool
        && request.resource.data.adminConditionRisk is bool
        && request.resource.data.adminAssessmentSummary is string
        && request.resource.data.adminAssessmentSummary.size() <= 5000
        && isValidReviewHistory();
    }

    function isValidNominationPromotionUpdate() {
      return resource.data.nominationStatus == 'approved'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'nominationStatus',
          'promotedPlaceId',
          'reviewHistory',
          'promotedAt',
          'updatedAt'
        ])
        && request.resource.data.nominationStatus == 'promoted'
        && isTrimmedString(request.resource.data.promotedPlaceId, 120)
        && isValidReviewHistory()
        && request.resource.data.promotedAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function hasPublicPlaceContributionFields() {
      return resource.data.keys().hasOnly([
          'placeId',
          'placeTitleSnapshot',
          'contributionText',
          'imageUrl',
          'imageCaption',
          'imageCredit',
          'imageRightsStatus',
          'contributionStatus',
          'createdAt',
          'updatedAt',
          'reviewedAt'
        ])
        && resource.data.keys().hasAll([
          'placeId',
          'contributionStatus'
        ]);
    }

    function requestHasPublicPlaceContributionFields() {
      return request.resource.data.keys().hasOnly([
          'placeId',
          'placeTitleSnapshot',
          'contributionText',
          'imageUrl',
          'imageCaption',
          'imageCredit',
          'imageRightsStatus',
          'contributionStatus',
          'createdAt',
          'updatedAt',
          'reviewedAt'
        ])
        && request.resource.data.keys().hasAll([
          'placeId',
          'contributionStatus'
        ]);
    }

    function isAllowedContributionImageRightsStatus(value) {
      return value in [
        'own-work',
        'permission-granted',
        'public-domain-or-open-license',
        'public-web-reference',
        'unknown-needs-review'
      ];
    }

    function hasValidPlaceContributionCreateFields() {
      return request.resource.data.keys().hasOnly([
          'placeId',
          'placeTitleSnapshot',
          'contributionText',
          'imageUrl',
          'imageCaption',
          'imageCredit',
          'imageRightsStatus',
          'imagePermissionConfirmed',
          'imageStoragePath',
          'imageFileName',
          'imageFileContentType',
          'imageFileSize',
          'imageUploadedAt',
          'imageUploadedByUid',
          'imageUploadVisibility',
          'submittedByUid',
          'submitterEmail',
          'submitterDisplayName',
          'contributionStatus',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'placeId',
          'submittedByUid',
          'contributionStatus'
        ]);
    }

    function hasUploadedContributionImageMetadataField() {
      return request.resource.data.keys().hasAny([
        'imageStoragePath',
        'imageFileName',
        'imageFileContentType',
        'imageFileSize',
        'imageUploadedAt',
        'imageUploadedByUid',
        'imageUploadVisibility'
      ]);
    }

    function hasUploadedContributionImagePath() {
      return hasField('imageStoragePath')
        && request.resource.data.imageStoragePath is string
        && request.resource.data.imageStoragePath.size() > 0;
    }

    function isValidUploadedContributionImageMetadata() {
      return !hasUploadedContributionImageMetadataField()
        || (
          hasUploadedContributionImagePath()
          && request.resource.data.imageStoragePath.size() <= 1000
          && request.resource.data.imageStoragePath.matches('^place-contribution-images/' + request.auth.uid + '/[^/]+/[^/]+$')
          && request.resource.data.imageFileName is string
          && request.resource.data.imageFileName.size() > 0
          && request.resource.data.imageFileName.size() <= 255
          && request.resource.data.imageFileContentType in [
            'image/jpeg',
            'image/png',
            'image/webp',
            'image/gif'
          ]
          && request.resource.data.imageFileSize is int
          && request.resource.data.imageFileSize > 0
          && request.resource.data.imageFileSize <= 5 * 1024 * 1024
          && request.resource.data.imageUploadedAt is timestamp
          && request.resource.data.imageUploadedByUid == request.auth.uid
          && request.resource.data.imageUploadVisibility == 'contribution-private'
        );
    }

    function hasContributionTextOrImage() {
      return (
          hasField('contributionText')
          && request.resource.data.contributionText is string
          && request.resource.data.contributionText.size() > 0
        )
        || (
          hasField('imageUrl')
          && request.resource.data.imageUrl is string
          && request.resource.data.imageUrl.size() > 0
        )
        || (
          hasUploadedContributionImagePath()
          && isValidUploadedContributionImageMetadata()
        );
    }

    function requestHasPublicContributionTextOrImageUrl() {
      return (
          request.resource.data.get('contributionText', null) is string
          && request.resource.data.get('contributionText', '').size() > 0
        )
        || (
          request.resource.data.get('imageUrl', null) is string
          && request.resource.data.get('imageUrl', '').size() > 0
        );
    }

    function isValidPlaceContributionCreate() {
      return request.auth != null
        && hasValidPlaceContributionCreateFields()
        && isTrimmedString(request.resource.data.placeId, 160)
        && request.resource.data.submittedByUid == request.auth.uid
        && request.resource.data.contributionStatus == 'submitted'
        && hasContributionTextOrImage()
        && isOptionalString('placeTitleSnapshot', 160)
        && isOptionalString('contributionText', 5000)
        && isOptionalHttpsEvidenceUrl('imageUrl', 1000)
        && isOptionalString('imageCaption', 300)
        && isOptionalString('imageCredit', 300)
        && (
          !hasField('imageRightsStatus')
          || request.resource.data.imageRightsStatus == null
          || (
            request.resource.data.imageRightsStatus is string
            && request.resource.data.imageRightsStatus.size() <= 64
            && isAllowedContributionImageRightsStatus(request.resource.data.imageRightsStatus)
          )
        )
        && (
          !hasField('imagePermissionConfirmed')
          || request.resource.data.imagePermissionConfirmed == null
          || request.resource.data.imagePermissionConfirmed is bool
        )
        && isValidUploadedContributionImageMetadata()
        && isOptionalString('submitterDisplayName', 120)
        && (
          !hasField('submitterEmail')
          || request.resource.data.submitterEmail == null
          || isValidEmailString(request.resource.data.submitterEmail, 254)
        )
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function isValidPlaceContributionApproveUpdate() {
      return isAdmin()
        && resource.data.contributionStatus == 'submitted'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'contributionStatus',
          'reviewedAt',
          'updatedAt',
          'imageUrl',
          'imageCaption',
          'imageCredit',
          'imageRightsStatus',
          'imagePermissionConfirmed',
          'imageStoragePath',
          'imageFileName',
          'imageFileContentType',
          'imageFileSize',
          'imageUploadedAt',
          'imageUploadedByUid',
          'imageUploadVisibility',
          'submittedByUid',
          'submitterEmail',
          'submitterDisplayName'
        ])
        && request.resource.data.contributionStatus == 'approved'
        && request.resource.data.reviewedAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && requestHasPublicPlaceContributionFields()
        && requestHasPublicContributionTextOrImageUrl()
        && isOptionalString('contributionText', 5000)
        && isOptionalHttpsEvidenceUrl('imageUrl', 1000)
        && isOptionalString('imageCaption', 300)
        && isOptionalString('imageCredit', 300)
        && (
          !hasField('imageRightsStatus')
          || request.resource.data.imageRightsStatus == null
          || (
            request.resource.data.imageRightsStatus is string
            && request.resource.data.imageRightsStatus.size() <= 64
            && isAllowedContributionImageRightsStatus(request.resource.data.imageRightsStatus)
          )
        );
    }

    function isValidPlaceContributionRejectUpdate() {
      return isAdmin()
        && resource.data.contributionStatus == 'submitted'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'contributionStatus',
          'reviewedAt',
          'reviewedByUid',
          'updatedAt',
          'adminNotes'
        ])
        && request.resource.data.contributionStatus == 'rejected'
        && request.resource.data.reviewedAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && isTrimmedString(request.resource.data.reviewedByUid, 120)
        && request.resource.data.reviewedByUid == request.auth.uid
        && isOptionalString('adminNotes', 5000);
    }

    match /news/{doc=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /history/{doc=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /communityPlaces/{doc=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /placeContributions/{contributionId} {
      allow read: if resource.data.contributionStatus == 'approved'
        && hasPublicPlaceContributionFields()
        || (
          isAdmin()
          && resource.data.contributionStatus in ['submitted', 'rejected']
        );
      allow create: if isValidPlaceContributionCreate();
      allow update: if isValidPlaceContributionApproveUpdate()
        || isValidPlaceContributionRejectUpdate();
      allow delete: if false;
    }

    match /placeNominations/{nominationId} {
      allow create: if isValidNominationCreate();
      allow read: if isAdmin() || isNominationOwner();
      allow update: if isAdmin() && (
        isValidNominationReviewUpdate()
        || isValidNominationPromotionUpdate()
      );
      allow delete: if false;
    }

    // Default deny for anything not explicitly allowed in this review draft.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
