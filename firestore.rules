rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Production-merge review draft only.
    // This repo did not previously contain local Firestore rules, so this file must
    // be reviewed before any Firebase Console update or deploy step. It does not
    // represent a deployed change on its own.

    function isAdmin() {
      return request.auth != null
        && request.auth.uid == "VT3I9KMktMXsdJeyYBye54Sgnqu2";
    }

    function isNominationOwner() {
      return request.auth != null
        && resource.data.submittedByUid == request.auth.uid;
    }

    function hasField(fieldName) {
      return request.resource.data.keys().hasAny([fieldName]);
    }

    function isAllowedCriteria(criteria) {
      return criteria is list
        && criteria.size() > 0
        && criteria.size() <= 9
        && criteria.hasOnly([
          'Historic interest',
          'Social or communal value',
          'Landmark or streetscape value',
          'Architectural, design or artistic interest',
          'Archaeological or evidential interest',
          'Rarity',
          'Group value',
          'Age',
          'Condition or vulnerability'
        ]);
    }

    function isTrimmedString(value, maxLength) {
      return value is string
        && value.size() > 0
        && value.size() <= maxLength;
    }

    function isValidEmailString(value, maxLength) {
      return isTrimmedString(value, maxLength)
        && value.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$');
    }

    function isOptionalString(fieldName, maxLength) {
      return !hasField(fieldName)
        || request.resource.data[fieldName] == null
        || (
          request.resource.data[fieldName] is string
          && request.resource.data[fieldName].size() <= maxLength
        );
    }

    function isOptionalHttpsEvidenceUrl(fieldName, maxLength) {
      return !hasField(fieldName)
        || request.resource.data[fieldName] == null
        || (
          request.resource.data[fieldName] is string
          && request.resource.data[fieldName].size() > 0
          && request.resource.data[fieldName].size() <= maxLength
          && request.resource.data[fieldName].matches('^https://[^\\s/]+\\.[^\\s/]+[^\\s]*$')
        );
    }

    function isOptionalNumber(fieldName) {
  return !hasField(fieldName)
    || request.resource.data[fieldName] == null
    || request.resource.data[fieldName] is int
    || request.resource.data[fieldName] is float
    || (
      request.resource.data[fieldName] is string
      && request.resource.data[fieldName].size() > 0
      && request.resource.data[fieldName].size() <= 40
      && request.resource.data[fieldName].matches('^-?[0-9]+(\\.[0-9]+)?$')
       );
   }

    function hasValidNominationFields() {
      return request.resource.data.keys().hasOnly([
          'title',
          'assetType',
          'area',
          'address',
          'lat',
          'lng',
          'description',
          'localSignificanceSummary',
          'heritageCriteria',
          'criteriaExplanation',
          'condition',
          'communityUse',
          'sourceReference',
          'evidenceImageUrl',
          'evidenceImageCaption',
          'evidenceCaption',
          'evidenceSourceCredit',
          'evidenceRightsStatus',
          'evidencePermissionConfirmed',
          'evidenceVisibility',
          'photoUrl',
          'photoDescription',
          'nominatorDisplayName',
          'nominatorEmail',
          'organisationName',
          'submittedOnBehalfOf',
          'submittedByUid',
          'submitterEmail',
          'submitterDisplayName',
          'submissionAuthType',
          'termsAccepted',
          'privacyAccepted',
          'nominationStatus',
          'createdAt',
          'updatedAt',
          'submittedAt'
        ])
        && request.resource.data.keys().hasAll([
          'title',
          'address',
          'description',
          'localSignificanceSummary',
          'heritageCriteria',
          'criteriaExplanation',
          'nominatorEmail',
          'submittedByUid',
          'submitterEmail',
          'submissionAuthType',
          'termsAccepted',
          'privacyAccepted',
          'nominationStatus',
          'createdAt',
          'updatedAt',
          'submittedAt'
        ]);
    }

    function isValidNominationCreate() {
      return hasValidNominationFields()
        && request.auth != null
        && isTrimmedString(request.resource.data.title, 160)
        && isTrimmedString(request.resource.data.address, 1000)
        && isTrimmedString(request.resource.data.description, 5000)
        && isTrimmedString(request.resource.data.localSignificanceSummary, 2000)
        && isAllowedCriteria(request.resource.data.heritageCriteria)
        && isTrimmedString(request.resource.data.criteriaExplanation, 5000)
        && isValidEmailString(request.resource.data.nominatorEmail, 254)
        && request.resource.data.submittedByUid == request.auth.uid
        && isValidEmailString(request.resource.data.submitterEmail, 254)
        && request.resource.data.submissionAuthType == 'signedIn'
        && request.resource.data.termsAccepted == true
        && request.resource.data.privacyAccepted == true
        && request.resource.data.nominationStatus == 'submitted'
        && isOptionalString('assetType', 100)
        && isOptionalString('area', 160)
        && isOptionalNumber('lat')
        && isOptionalNumber('lng')
        && isOptionalString('condition', 1500)
        && isOptionalString('communityUse', 1500)
        && isOptionalString('sourceReference', 2000)
        && isOptionalString('evidenceImageUrl', 1000)
        && isOptionalString('evidenceImageCaption', 300)
        && isOptionalString('evidenceCaption', 300)
        && isOptionalString('evidenceSourceCredit', 300)
        && (
          !hasField('evidenceRightsStatus')
          || request.resource.data.evidenceRightsStatus == null
          || request.resource.data.evidenceRightsStatus == ''
          || (
            request.resource.data.evidenceRightsStatus is string
            && (
              request.resource.data.evidenceRightsStatus == 'own-work'
              || request.resource.data.evidenceRightsStatus == 'permission-granted'
              || request.resource.data.evidenceRightsStatus == 'public-domain-or-open-license'
              || request.resource.data.evidenceRightsStatus == 'public-web-reference'
              || request.resource.data.evidenceRightsStatus == 'unknown-needs-review'
            )
          )
        )
        && (
          !hasField('evidencePermissionConfirmed')
          || request.resource.data.evidencePermissionConfirmed == null
          || request.resource.data.evidencePermissionConfirmed is bool
        )
        && (
          !hasField('evidenceVisibility')
          || request.resource.data.evidenceVisibility == null
          || request.resource.data.evidenceVisibility == ''
          || request.resource.data.evidenceVisibility == 'nomination-private'
        )
        && isOptionalString('photoUrl', 2048)
        && isOptionalString('photoDescription', 1000)
        && isOptionalString('nominatorDisplayName', 120)
        && isOptionalString('organisationName', 180)
        && isOptionalString('submitterDisplayName', 120)
        && (
          !hasField('submittedOnBehalfOf')
          || request.resource.data.submittedOnBehalfOf == null
          || request.resource.data.submittedOnBehalfOf in [
            'self',
            'someone-else',
            'organisation'
          ]
        );
    }

    function isValidNominationReviewStatus(value) {
      return value in [
        'submitted',
        'under review',
        'needs more information',
        'approved',
        'rejected'
      ];
    }

    function isValidReviewHistory() {
      return !hasField('reviewHistory')
        || (
          request.resource.data.reviewHistory is list
          && request.resource.data.reviewHistory.size() <= 50
        );
    }

    function isValidNominationReviewUpdate() {
      return resource.data.nominationStatus != 'promoted'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'nominationStatus',
          'adminNotes',
          'adminHistoricInterest',
          'adminArchitecturalInterest',
          'adminCommunityValue',
          'adminConditionRisk',
          'adminAssessmentSummary',
          'reviewHistory',
          'reviewedAt',
          'updatedAt'
        ])
        && isValidNominationReviewStatus(request.resource.data.nominationStatus)
        && request.resource.data.adminNotes is string
        && request.resource.data.adminNotes.size() <= 5000
        && request.resource.data.adminHistoricInterest is bool
        && request.resource.data.adminArchitecturalInterest is bool
        && request.resource.data.adminCommunityValue is bool
        && request.resource.data.adminConditionRisk is bool
        && request.resource.data.adminAssessmentSummary is string
        && request.resource.data.adminAssessmentSummary.size() <= 5000
        && isValidReviewHistory();
    }

    function isValidNominationPromotionUpdate() {
      return resource.data.nominationStatus == 'approved'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'nominationStatus',
          'promotedPlaceId',
          'reviewHistory',
          'promotedAt',
          'updatedAt'
        ])
        && request.resource.data.nominationStatus == 'promoted'
        && isTrimmedString(request.resource.data.promotedPlaceId, 120)
        && isValidReviewHistory()
        && request.resource.data.promotedAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    match /news/{doc=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /history/{doc=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /communityPlaces/{doc=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /placeNominations/{nominationId} {
      allow create: if isValidNominationCreate();
      allow read: if isAdmin() || isNominationOwner();
      allow update: if isAdmin() && (
        isValidNominationReviewUpdate()
        || isValidNominationPromotionUpdate()
      );
      allow delete: if false;
    }

    // Default deny for anything not explicitly allowed in this review draft.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
