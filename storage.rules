rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.uid == 'VT3I9KMktMXsdJeyYBye54Sgnqu2';
    }

    function isAllowedNominationEvidenceImage() {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
    }

    match /nomination-evidence/{uid}/{draftId}/{fileId} {
      allow create, update: if isSignedIn()
        && request.auth.uid == uid
        && isAllowedNominationEvidenceImage();
      allow read: if isAdmin();
      allow delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
